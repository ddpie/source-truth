        "view": "singleValue",
        "period": 3600,
        "sparkline": true,
        "yAxis": {
          "left": {
            "min": 0,
            "max": 1,
            "showUnits": false
          }
        },
        "metrics": [
          [
            "${NAMESPACE}",
            "AnswerCompleted",
            {
              "id": "scok",
              "visible": false,
              "stat": "Sum"
            }
          ],
          [
            "${NAMESPACE}",
            "QuestionsReceived",
            {
              "id": "scq",
              "visible": false,
              "stat": "Sum"
            }
          ],
          [
            {
              "expression": "scok / scq",
              "label": "成功率",
              "id": "scr"
            }
          ]
        ]
      }
    },
